<project name="CalculatorUIProject" default="compile" basedir=".">

    <property name="src1.dir" value="../Java Project"/>
    <property name="src2.dir" value="."/>
    <property name="build.dir" value="calculator_Build"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <javac destdir="${build.dir}" includeantruntime="false">
            <src path="${src1.dir}"/>
            <src path="${src2.dir}"/>

            <exclude name="MyInfArith.java"/>
        </javac>
    </target>

</project>








