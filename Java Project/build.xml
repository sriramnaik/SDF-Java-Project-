<project name="ArbitraryArithmetic" default="compile" basedir=".">
    <property name="src.dir" value="arbitraryarithmetic"/>
    <property name="build.dir" value="build"/>
    <property name="MyInfArith" value="MyInfArith.java"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile" depends="Myinf">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.dir}"/>
    </target>

    <target name="Myinf">
        <mkdir dir="${build.dir}"/>
        <javac srcdir="." destdir="${build.dir}" includes="MyInfArith.java"/>
    </target>            

</project>